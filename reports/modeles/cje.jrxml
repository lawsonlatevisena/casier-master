				</reportElement>
				<textElement markup="styled">
					<font fontName="FoundrySterling-Bold" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["n 'a subi aucune condamnation depuis son arrivée au Togo."]]></textFieldExpression>
			</textField>
